# ================================================================
# COVE MVP - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# Hosted on GitHub Pages: https://n02448428.github.io/Cove
# ================================================================

# ---- Frontend (Vite) -------------------------------------------
# Supabase project URL
VITE_SUPABASE_URL=https://csbstpehuunaoyehhixp.supabase.co

# Supabase publishable (anon) key - safe to expose in browser
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ---- Backend / Edge Functions ----------------------------------
# Supabase service role key - NEVER expose publicly
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Supabase URL (same as above, used in Edge Functions)
SUPABASE_URL=https://csbstpehuunaoyehhixp.supabase.co

# ---- Twilio ----------------------------------------------------
# Your Twilio Account SID (starts with AC...)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your Twilio Auth Token
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# The Twilio number used for SMS notifications (E.164 format)
# Note: concierge numbers are auto-assigned per user and stored in DB
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ---- Retell AI -------------------------------------------------
# Your Retell API key
RETELL_API_KEY=your_retell_api_key

# Your Retell agent ID (Concierge MVP agent)
RETELL_AGENT_ID=your_retell_agent_id

# ---- Resend (Email notifications) ------------------------------
# Your Resend API key
RESEND_API_KEY=your_resend_api_key

# ---- App -------------------------------------------------------
# Base URL used in Edge Function webhook callbacks
# Production (GH Pages frontend + Supabase Edge Functions):
APP_BASE_URL=https://csbstpehuunaoyehhixp.supabase.co
# Local dev (Supabase local):
# APP_BASE_URL=http://localhost:54321

# ---- Local dev server ------------------------------------------
PORT=5173

# ---- Stripe (live) ---------------------------------------------
# Publishable key for frontend (optional until Portal/Elements)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxx

# Secret key — Edge Functions only, NEVER expose in Vite
STRIPE_SECRET_KEY=sk_live_xxxxxxxx

# Webhook signing secret from Stripe Dashboard → Webhooks
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

# Price ID for $49/mo (lookup cove_monthly_49); Product prod_VEle9mZGSVfiUT
STRIPE_PRICE_ID_49_MONTHLY=price_1UEI7KBGpVuNZeuZ03lbTAtF

# Frontend URL for Checkout success/cancel (SPA). Prefer this over APP_BASE_URL
# when APP_BASE_URL is the Supabase project URL (used by voice Edge Functions).
FRONTEND_URL=https://withcove.co

# Optional override for Twilio voice webhook on purchased DIDs
# TWILIO_VOICE_WEBHOOK_URL=https://csbstpehuunaoyehhixp.supabase.co/functions/v1/twilio-voice-inbound